{
  "name": "v-coder",
  "productName": "V-Coder",
  "version": "1.0.0",
  "description": "V-Coder — an open desktop AI coding studio. Bring your own models.",
  "license": "MIT",
  "author": {
    "name": "Shanib Muhammed",
    "email": "shanibmuhammed@users.noreply.github.com"
  },
  "homepage": "https://github.com/Shanib-Muhammed/v-coder-REA-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shanib-Muhammed/v-coder-REA-desktop.git"
  },
  "main": "electron/main.cjs",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node scripts/smoke.cjs && node scripts/e2e-agent.cjs",
    "test:ui": "electron scripts/ui-e2e.cjs",
    "icons": "node scripts/make-icons.cjs",
    "pack": "npm run icons && electron-builder --dir",
    "dist": "npm run icons && electron-builder",
    "dist:win": "npm run icons && electron-builder --win",
    "dist:mac": "npm run icons && electron-builder --mac",
    "dist:linux": "npm run icons && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
